{
  "name": "@scalar/asyncapi-to-markdown",
  "description": "Create plain Markdown from AsyncAPI documents (for LLMs)",
  "license": "MIT",
  "author": "Scalar (https://github.com/scalar)",
  "homepage": "https://github.com/scalar/scalar",
  "bugs": "https://github.com/scalar/scalar/issues/new/choose",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scalar/scalar.git",
    "directory": "packages/asyncapi-to-markdown"
  },
  "keywords": [
    "asyncapi",
    "markdown",
    "llm"
  ],
  "version": "0.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "benchmark": "tsx benchmarks/run.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "cd playground && vite",
    "test": "vitest --run",
    "types:check": "tsgo --noEmit && vue-tsc --noEmit -p playground/tsconfig.json"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@scalar/asyncapi-upgrader": "workspace:*",
    "@scalar/helpers": "workspace:*",
    "@scalar/json-magic": "workspace:*",
    "@scalar/openapi-to-markdown": "workspace:*",
    "@scalar/types": "workspace:*",
    "@scalar/workspace-store": "workspace:*",
    "remark-gfm": "catalog:*",
    "remark-stringify": "catalog:*",
    "unified": "catalog:*"
  },
  "devDependencies": {
    "@scalar/components": "workspace:*",
    "@scalar/themes": "workspace:*",
    "@tailwindcss/vite": "catalog:*",
    "@types/mdast": "catalog:*",
    "@vitejs/plugin-vue": "catalog:*",
    "marked": "^14.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "tailwindcss": "catalog:*",
    "tsx": "catalog:*",
    "vite": "catalog:*",
    "vitest": "catalog:*",
    "vue": "catalog:*",
    "vue-tsc": "catalog:*"
  }
}
