exports[`cohttp > 'pretty-prints --data bodies whose mim…' 1`] = `
"open Lwt.Infix

let () =
  Lwt_main.run (
    let uri = Uri.of_string "https://example.com" in
    let headers = Cohttp.Header.of_list [
      ("Content-Type", "application/vnd.api+json");
    ] in
