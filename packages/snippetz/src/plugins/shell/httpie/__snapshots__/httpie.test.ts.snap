// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`httpie > curl: 'adds basic auth credentials' 1`] = `
"http --ignore-stdin 'GET' 'https://example.com' \\
  'Authorization:Basic dXNlcjpwYXNz'"
`;

exports[`httpie > curl: 'doesn\\'t add empty cookies' 1`] = `"http --ignore-stdin 'GET' 'https://example.com'"`;

exports[`httpie > curl: 'doesn\\'t add empty headers' 1`] = `"http --ignore-stdin 'GET' 'https://example.com'"`;

exports[`httpie > curl: 'escapes single quotes in JSON body' 1`] = `
"http --ignore-stdin 'POST' 'https://editor.scalar.com/test' \\
  'Content-Type:application/json' \\
  --raw '"hell'\\''o"'"
`;

exports[`httpie > curl: 'handles JSON body with special charac…' 1`] = `
"http --ignore-stdin 'POST' 'https://example.com' \\
  'Content-Type:application/json' \\
  --raw '{"key":"\\"quotes\\" and \\\\backslashes\\\\","nested":{"array":["item1",null,null]}}'"
`;

exports[`httpie > curl: 'handles URLs with dollar sign charact…' 1`] = `"http --ignore-stdin 'GET' 'https://example.com/path$with$dollars'"`;

exports[`httpie > curl: 'handles URLs with dollar signs in pat…' 1`] = `"http --ignore-stdin 'GET' 'https://example.com/api$v1/prices?amount=%2450.00'"`;

exports[`httpie > curl: 'handles URLs with dollar signs in que…' 1`] = `"http --ignore-stdin 'GET' 'https://example.com?price=%24100&currency=USD%24'"`;

exports[`httpie > curl: 'handles binary data flag' 1`] = `
"http --ignore-stdin 'POST' 'https://example.com' \\
  'Content-Type:application/octet-stream' \\
  --raw 'binary content'"
`;

exports[`httpie > curl: 'handles compressed response' 1`] = `
"http --ignore-stdin 'GET' 'https://example.com' \\
  'Accept-Encoding:gzip, deflate'"
`;

exports[`httpie > curl: 'handles cookies with special characte…' 1`] = `
"http --ignore-stdin 'GET' 'https://example.com' \\
  'Cookie:special%3Bcookie=value%20with%20spaces'"
`;

exports[`httpie > curl: 'handles empty URL' 1`] = `"http --ignore-stdin 'GET' ''"`;

exports[`httpie > curl: 'handles extremely long URLs' 1`] = `"http --ignore-stdin 'GET' 'https://example.'"`;

exports[`httpie > curl: 'handles headers with empty values' 1`] = `
"http --ignore-stdin 'GET' 'https://example.com' \\
  'X-Empty;'"
`;

exports[`httpie > curl: 'handles multipart form data content t…' 1`] = `
"{
  printf '%b' '--scalar-boundary\\0015\\0012Content-Disposition: form-data; name="user"\\0015\\0012Content-Type: application/json;charset=utf-8\\0015\\0012\\0015\\0012'
  printf '%b' '{"name":"scalar"}'
  printf '%b' '\\0015\\0012'
  printf '%b' '--scalar-boundary--\\0015\\0012'
} | http 'POST' 'https://example.com' \\
  'Content-Type:multipart/form-data; boundary=scalar-boundary'"
`;

exports[`httpie > curl: 'handles multipart form data content t…' 2`] = `
"{
  printf '%b' '--scalar-boundary\\0015\\0012Content-Disposition: form-data; name="file"; filename="test.txt"\\0015\\0012Content-Type: text/plain\\0015\\0012\\0015\\0012'
  cat -- 'test.txt'
  printf '%b' '\\0015\\0012'
  printf '%b' '--scalar-boundary--\\0015\\0012'
} | http 'POST' 'https://example.com' \\
  'Content-Type:multipart/form-data; boundary=scalar-boundary'"
`;

exports[`httpie > curl: 'handles multipart form data with JSON…' 1`] = `
"http --ignore-stdin 'POST' 'https://example.com' \\
  'Content-Type:multipart/form-data' \\
  --raw '{"foo":"bar"}'"
`;

exports[`httpie > curl: 'handles multipart form data with empt…' 1`] = `
"{
  printf '%b' '--scalar-boundary\\0015\\0012Content-Disposition: form-data; name="file"; filename=""\\0015\\0012Content-Type: application/octet-stream\\0015\\0012\\0015\\0012'
  cat -- ''
  printf '%b' '\\0015\\0012'
  printf '%b' '--scalar-boundary--\\0015\\0012'
} | http 'POST' 'https://example.com' \\
