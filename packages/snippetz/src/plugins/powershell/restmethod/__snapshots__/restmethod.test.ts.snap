// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`restmethod > 'adds basic auth credentials' 1`] = `
"$headers = @{
  'Authorization' = 'Basic dXNlcjpwYXNz'
}

$response = Invoke-RestMethod -Uri 'https://example.com' -Method 'GET' -Headers $headers
$response"
`;

exports[`restmethod > 'doesn\\'t add empty cookies' 1`] = `
"$response = Invoke-RestMethod -Uri 'https://example.com' -Method 'GET'
$response"
`;

exports[`restmethod > 'doesn\\'t add empty headers' 1`] = `
"$response = Invoke-RestMethod -Uri 'https://example.com' -Method 'GET'
$response"
`;

exports[`restmethod > 'escapes single quotes in JSON body' 1`] = `
"$headers = @{
  'Content-Type' = 'application/json'
}

$body = [System.IO.MemoryStream]::new()
$bytes = [System.Text.Encoding]::UTF8.GetBytes('"hell''o"')
$body.Write($bytes, 0, $bytes.Length)

$response = Invoke-RestMethod -Uri 'https://editor.scalar.com/test' -Method 'POST' -Headers $headers -Body $body.ToArray()
$body.Dispose()
$response"
`;

