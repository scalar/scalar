{
  "extends": "./tsconfig.json",
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.stories.ts", "**/*.e2e.ts"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  }
}
