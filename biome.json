{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!!.worktrees",
      "!!.claude",
      "!!.codex/worktrees",
      "!**/.venv",
      "!**/.turbo",
      "!**/.nuxt",
      "!**/.vite",
      "!**/.output",
      "!**/.vite-ssg-temp",
      "!**/vite.config.ts.timestamp-*",
      "!**/package.json",
      "!**/test-results/**",
      "!**/build/**",
      "!**/cdn/**",
      "!**/fixtures/**",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/playwright-report/**",
      "!**/playwright-results.json",
      "!**/pnpm-lock.yaml",
      "!**/.pnpm-store/**",
      "!**/.docusaurus/**",
      "!**/examples/nestjs-api-reference-fastify/**",
      "!**/examples/nestjs-api-reference-express/**",
      "!**/*/storybook-static/**/*",
      "!**/.next/**",
      "!**/.svelte-kit",
      "!**/obj/**",
      "!**/bin/**",
      "!**/packages/openapi-validator/src/schemas/**/*.ts",
      "!**/packages/openapi-parser/tests/openapi3-examples/**/*.{yml,yaml,json}",
      "!**/packages/openapi-validator/tests/openapi3-examples/**/*.{yml,yaml,json}",
      "!integrations/**/scalar.js",
      "!integrations/**/standalone.js",
      "!**/packages/api-reference/esm.js",
      "!**/target/**",
      "!**/*.svg",
      "!integrations/docker/assets/index.html"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "lexicographic",
            "groups": [":NODE:", ":BLANK_LINE:", ":PACKAGE:", ":BLANK_LINE:", ":ALIAS:", ":BLANK_LINE:", ":PATH:"]
          }
        }
      }
    }
  },
  "formatter": {
    "formatWithErrors": false,
    "includes": [
      "**",
      "!**/.git",
      "!**/.svn",
      "!**/.hg",
      "!**/.tmp",
      "!**/node_modules",
      "!**/dist",
      "!**/generated",
      "!**/venv",
      "!**/.venv",
      "!**/playwright-report",
      "!**/.vite-ssg-temp",
      "!**/pnpm-lock.yaml",
      "!**/fixtures"
    ],
    "enabled": true,
    "lineEnding": "lf",
    "indentWidth": 2,
    "lineWidth": 120,
    "indentStyle": "space",
    "attributePosition": "multiline"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "quoteProperties": "preserve",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "complexity": {
        "noExtraBooleanCast": "warn",
        "noUselessCatch": "warn",
        "noUselessTypeConstraint": "warn",
        "noForEach": "off",
        "useFlatMap": "warn",
        "useArrowFunction": "warn",
        "useOptionalChain": "warn",
        "noAdjacentSpacesInRegex": "warn",
        "noArguments": "warn"
      },
      "correctness": {
        "noConstAssign": "error",
        "noConstantCondition": "warn",
        "noConstantMathMinMaxClamp": "error",
        "noEmptyCharacterClassInRegex": "warn",
        "noEmptyPattern": "warn",
        "noGlobalDirnameFilename": "error",
        "noGlobalObjectCalls": "error",
        "noInnerDeclarations": "warn",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noNonoctalDecimalEscape": "warn",
        "noPrecisionLoss": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noStringCaseMismatch": "error",
        "noSwitchDeclarations": "warn",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedLabels": "warn",
        "noUnusedPrivateClassMembers": "warn",
        "noUnusedVariables": "warn",
        "useIsNan": "error",
        "useValidForDirection": "error",
        "useYield": "warn",
        "noUnusedImports": "warn",
        "useValidTypeof": "error"
      },
      "style": {
        "noNamespace": "warn",
        "noParameterAssign": "warn",
        "useAsConstAssertion": "warn",
        "useBlockStatements": "warn",
        "useForOf": "warn",
        "useNodejsImportProtocol": "warn",
        "useNumberNamespace": "warn",
        "noUselessElse": "warn",
        "useImportType": "warn",
        "useExportType": "warn",
        "noUnusedTemplateLiteral": "warn",
        "useShorthandFunctionType": "warn",
        "useConst": "warn",
        "useArrayLiterals": "warn",
        "noDescendingSpecificity": "warn",
        "noNestedTernary": "warn"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCompareNegZero": "error",
        "noControlCharactersInRegex": "warn",
        "noDebugger": "warn",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noEmptyBlockStatements": "warn",
        "noExtraNonNullAssertion": "warn",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noImportAssign": "error",
        "noMisleadingCharacterClass": "warn",
        "noMisleadingInstantiator": "warn",
        "noMisrefactoredShorthandAssign": "error",
        "noPrototypeBuiltins": "warn",
        "noRedeclare": "error",
        "noSelfCompare": "error",
        "noShadowRestrictedNames": "warn",
        "noSparseArray": "warn",
        "noTsIgnore": "error",
        "noUnsafeDeclarationMerging": "warn",
        "noUnsafeNegation": "error",
        "useGetterReturn": "error",
        "useNamespaceKeyword": "warn",
        "noDoubleEquals": "warn",
        "noThenProperty": "warn",
        "useIsArray": "warn",
        "noExplicitAny": "off",
        "noExportsInTest": "error",
        "noWith": "warn",
        "noVar": "warn",
        "useAwait": "error",
        "useGuardForIn": "warn"
      },
      "performance": {
        "noDelete": "off",
        "noReExportAll": "warn",
        "noBarrelFile": "error"
      },
      "nursery": {
        "noFloatingPromises": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "style": {
            "useShorthandFunctionType": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.tsx"],
      "javascript": {
        "jsxRuntime": "reactClassic"
      }
    },
    {
      "includes": ["packages/*/src/**", "!packages/*/src/**/*.{test,e2e}.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@test/*", "**/test/**"],
                    "message": "Do not import test helpers inside source files"
                  },
                  {
                    "group": ["@scalar/types"],
                    "message": "Import from specific entry points (`/api-reference`, ...)"
                  },
                  {
                    "group": ["@scalar/components"],
                    "message": "Import from a component subpath (e.g. `@scalar/components/button`) instead of the package barrel."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["projects/**/*.{ts,tsx}", "integrations/**/*.{ts,tsx}", "examples/**/*.{ts,tsx}", "!**/dist/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@scalar/components"],
                    "message": "Import from a component subpath (e.g. `@scalar/components/button`) instead of the package barrel."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/**/index.{js,ts}",
        "projects/*/src/**/index.{js,ts}",
        "integrations/*/index.ts",
        "integrations/*/src/**/index.ts",
        "packages/highlight/src/{all,lazy}.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["**/packages/api-reference/**/*.ts", "**/packages/openapi-parser/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte", "**/*.astro"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      },
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
