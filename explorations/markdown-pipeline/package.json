{
  "name": "@scalar-internal/markdown-pipeline-exploration",
  "private": true,
  "description": "Harness comparing the Markdown pipeline in @scalar/markdown with the unified renderer it replaced",
  "type": "module",
  "scripts": {
    "setup": "node bench/corpus.mjs && node bench/build.mjs",
    "build": "node bench/build.mjs",
    "test": "vitest run",
    "spec": "node bench/spec.mjs",
    "spec:compare": "node bench/spec-vs.mjs",
    "size": "node bench/size.mjs baseline && node bench/size-proto.mjs && node bench/size-alt.mjs",
    "size:breakdown": "node bench/compose.mjs",
    "bench": "node bench/bench-proto.mjs",
    "bench:alternatives": "node bench/bench.mjs",
    "parity": "node bench/diff-corpus.mjs",
    "security": "node bench/attack.mjs 300000",
    "sanitizer": "node bench/sanitizer-suites.mjs && node --stack-size=4000 bench/sanitizer-run.mjs --baseline",
    "pathological": "node --stack-size=4000 bench/patho.mjs 30000",
    "corpora": "node bench/apis-guru.mjs && node bench/markdown-files.mjs && node bench/fixtures.mjs && node bench/fuzz-corpus.mjs 25000 7",
    "gamut": "for l in apis-guru markdown-files fixtures fuzz; do node bench/differential.mjs .out/$l.json $l${SHIPPED:+-shipped} && node bench/classify.mjs $l${SHIPPED:+-shipped}; done",
    "minimize": "node bench/minimize.mjs fuzz 1000",
    "visual": "for l in apis-guru markdown-files fixtures; do node bench/visual.mjs diff $l 2000 && node bench/visual.mjs same $l 3000; done",
    "copy:build": "node bench/copy-build.mjs",
    "copy:parity": "node --stack-size=4000 bench/copy-parity.mjs",
    "copy:documents": "node bench/copy-documents.mjs",
    "copy:roundtrip": "node --stack-size=4000 bench/copy-roundtrip.mjs",
    "copy:security": "node --stack-size=4000 bench/copy-security.mjs"
  },
  "devDependencies": {
    "commonmark": "0.31.2",
    "commonmark-spec": "0.31.2",
    "hast-util-to-mdast": "10.1.2",
    "markdown-it": "14.3.3",
    "marked": "14.1.4",
    "mdast-util-gfm": "3.0.0",
    "mdast-util-to-markdown": "2.1.0",
    "mdast-util-to-markdown-latest": "npm:mdast-util-to-markdown@2.1.2",
    "micromark": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "parse5": "7.3.0",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "rolldown": "1.2.14",
    "unified": "11.0.5",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "bail": "2.0.2",
      "ccount": "2.0.1",
      "character-entities": "2.0.2",
      "comma-separated-tokens": "2.0.3",
      "decode-named-character-reference": "1.0.2",
      "entities": "6.0.1",
      "escape-string-regexp": "5.0.0",
      "extend": "3.0.2",
      "hast-util-embedded": "3.0.0",
      "hast-util-from-html": "2.0.3",
      "hast-util-from-parse5": "8.0.1",
      "hast-util-has-property": "3.0.0",
      "hast-util-is-body-ok-link": "3.0.0",
      "hast-util-is-element": "3.0.0",
      "hast-util-parse-selector": "4.0.0",
      "hast-util-phrasing": "3.0.1",
      "hast-util-sanitize": "5.0.1",
      "hast-util-to-mdast": "10.1.2",
      "hast-util-to-text": "4.0.5",
      "hast-util-whitespace": "3.0.0",
      "hastscript": "8.0.0",
      "is-plain-obj": "4.1.0",
      "longest-streak": "3.1.0",
      "markdown-table": "3.0.3",
      "mdast-util-find-and-replace": "3.0.1",
      "mdast-util-from-markdown": "2.0.1",
      "mdast-util-gfm": "3.0.0",
      "mdast-util-gfm-autolink-literal": "2.0.0",
      "mdast-util-gfm-footnote": "2.0.0",
      "mdast-util-gfm-strikethrough": "2.0.0",
      "mdast-util-gfm-table": "2.0.0",
      "mdast-util-gfm-task-list-item": "2.0.0",
      "mdast-util-phrasing": "4.1.0",
      "mdast-util-to-markdown": "2.1.0",
      "mdast-util-to-string": "4.0.0",
      "micromark": "4.0.0",
      "micromark-core-commonmark": "2.0.1",
      "micromark-extension-gfm": "3.0.0",
      "micromark-extension-gfm-autolink-literal": "2.0.0",
      "micromark-extension-gfm-footnote": "2.0.0",
      "micromark-extension-gfm-strikethrough": "2.0.0",
      "micromark-extension-gfm-table": "2.0.0",
      "micromark-extension-gfm-task-list-item": "2.0.1",
      "micromark-factory-destination": "2.0.0",
      "micromark-factory-label": "2.0.0",
      "micromark-factory-space": "2.0.0",
      "micromark-factory-title": "2.0.0",
      "micromark-factory-whitespace": "2.0.0",
      "micromark-util-character": "2.1.0",
