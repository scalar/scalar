{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": {
    "enabled": false
  },
  "timezone": "Europe/Berlin",
  "schedule": ["* 6-9 * * 1"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "rangeStrategy": "bump",
  "constraints": {
    "ghActionsLock": "v0.5.1"
  },
  "vulnerabilityAlerts": {
    "rangeStrategy": "bump",
    "assignees": ["@hanspagel"],
    "labels": ["dependencies", "security"]
  },
  "recreateWhen": "never",
  "enabledManagers": [
    "npm",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "devcontainer",
    "cargo",
    "gomod",
    "maven",
    "nuget",
    "pip_requirements",
    "pep621",
    "nvm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["NETLIFY_CLI_VERSION:\\s*['\"]?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "netlify",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Keep npm release age aligned with pnpm-workspace.yaml",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "One weekly npm dependency PR, including npm tools pinned in CI",
      "matchDatasources": ["npm", "node-version"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "npm dependencies",
      "semanticCommitScope": "deps"
    },
    {
      "description": "One weekly GitHub Actions PR across all workflows",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "GitHub Actions",
      "semanticCommitScope": "actions"
    },
    {
      "description": "One weekly Docker PR, including container images used by GitHub Actions",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "Docker images",
      "semanticCommitScope": "docker"
    },
    {
      "description": "One weekly native dependency PR across Python, Rust, Go, Java, and .NET",
      "matchManagers": ["cargo", "gomod", "maven", "nuget", "pip_requirements", "pep621"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "native dependencies",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Keep updates Renovate flags as breaking out of the weekly groups",
      "matchIsBreaking": true,
      "groupName": null,
      "semanticCommitScope": "deps"
    },
    {
      "description": "Retain review warnings for secret-consuming actions in the weekly GitHub Actions group",
      "matchDepTypes": ["action"],
      "matchPackageNames": [
        "cloudflare/wrangler-action",
        "changesets/action",
        "peter-evans/create-pull-request",
        "peter-evans/dockerhub-description",
        "akhilmhdh/contributors-readme-action",
        "daun/playwright-report-summary",
        "thollander/actions-comment-pull-request",
        "amannn/action-semantic-pull-request",
        "fjogeleit/http-request-action",
        "useblacksmith/build-push-action",
        "docker/login-action"
      ],
      "automerge": false,
      "addLabels": ["security-sensitive"],
      "prBodyNotes": [
        ":lock: **Security-sensitive update.** This PR includes one or more actions that receive secrets at runtime. Review each affected action's diff between the current and target commit SHAs, its changelog, and any third-party dependencies it pulls in before merging."
      ]
    },
    {
      "description": "Keep public peer compatibility ranges for deliberate manual changes",
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "Preserve the Node 24 runtime and type lane; Node 26 is deferred",
      "matchDatasources": ["npm", "node-version"],
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "^24.0.0"
    },
    {
      "description": "Preserve TypeScript 5 consumer and Nuxt compatibility",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "matchCurrentVersion": "^5.0.0",
      "allowedVersions": "^5.0.0"
    },
    {
      "description": "Preserve the TypeScript 6 compiler API lane",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "matchCurrentVersion": "^6.0.0",
      "allowedVersions": "^6.0.0"
    },
    {
      "description": "Defer type-fest 6 to preserve existing consumer compiler support",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["type-fest"],
      "allowedVersions": "^5.0.0"
    },
    {
      "description": "Hold vue-tsc until the known compiler crashes and diagnostics are resolved",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["vue-tsc"],
      "allowedVersions": "3.3.11"
    },
    {
      "description": "Hold Nuxt module-builder until its transformer peer mismatch is resolved",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@nuxt/module-builder"],
      "allowedVersions": "1.0.2"
    },
    {
      "description": "Hold CVA at the beta supporting existing public consumers",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["cva"],
      "allowedVersions": "1.0.0-beta.4"
    },
    {
      "description": "Keep the deliberate Rolldown and Astro alignment until reviewed together",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["rolldown"],
      "allowedVersions": "1.3.2"
    },
    {
      "description": "Disable engine updates like node, github runner, and uses-with",
      "matchDepTypes": ["engines", "github-runner", "uses-with"],
      "enabled": false
    },
    {
      "description": "Keep these packages as low as possible for best compatibility",
      "matchFileNames": ["integrations/dotnet/Directory.Packages.props"],
      "matchPackageNames": ["Microsoft.AspNetCore.OpenApi", "Swashbuckle.AspNetCore.SwaggerGen"],
      "enabled": false
    },
    {
      "description": "Disable patch updates for Aspire.Hosting for best compatibility",
      "matchFileNames": ["integrations/dotnet/Directory.Packages.props"],
      "matchPackageNames": ["Aspire.Hosting"],
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "description": "Allow unstable updates for Aspire.Hosting.Docker and Aspire.Hosting.Keycloak since no stable packages exist yet",
      "matchPackageNames": ["Aspire.Hosting.Docker", "Aspire.Hosting.Keycloak"],
      "ignoreUnstable": false
    },
    {
      "description": "Disable any docker updates for Aspire",
      "matchFileNames": ["**/aspire/**"],
      "matchDatasources": ["docker"],
      "enabled": false
    },
    {
      "description": "Disable .NET SDK updates",
      "matchFileNames": ["**/global.json"],
      "enabled": false
    },
    {
      "description": "Disable major updates for Microsoft.AspNetCore packages",
      "matchPackageNames": ["Microsoft.AspNetCore**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep Spring Boot dependencies as low as possible for best compatibility",
      "matchFileNames": ["integrations/java/**"],
      "matchPackageNames": ["org.springframework.boot:*"],
      "enabled": false
    },
    {
      "description": "Disable updates for node docker images. We update images manually.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node**"],
      "enabled": false
    },
    {
      "description": "Runner pins are synchronized by the image-gated npm update, never independently",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["scalarapi/playwright-runner"],
      "enabled": false
    }
  ],
  "npm": {
    "packageRules": [
      {
        "description": "Run after generated npm advisory rules, then gate Playwright lookup on published runner tags",
        "matchManagers": ["npm"],
        "matchPackageNames": ["@playwright/test"],
        "overrideDatasource": "docker",
        "overridePackageName": "scalarapi/playwright-runner",
        "versioning": "semver"
      },
      {
        "description": "Use one native npm update to synchronize every Playwright companion pin",
        "matchDatasources": ["docker"],
        "matchPackageNames": ["scalarapi/playwright-runner"],
        "groupName": "Playwright client and runner",
        "versioning": "semver",
        "semanticCommitScope": "playwright",
        "matchManagers": ["npm"],
        "minimumReleaseAge": "1 day",
        "bumpVersions": [
          {
            "name": "Playwright helper default",
            "filePatterns": ["packages/helpers/src/playwright/docker.ts"],
            "matchStrings": ["DEFAULT_PLAYWRIGHT_VERSION = '(?<version>[^']+)'"],
            "bumpType": "sync"
          },
          {
            "name": "Playwright selected image tag",
            "filePatterns": ["tooling/scripts/src/commands/playwright-docker/release-tag"],
            "matchStrings": ["^(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9_.-]+)?)\\s*$"],
            "bumpType": "sync"
          },
          {
            "name": "Playwright test-integrations runner",
            "filePatterns": [".github/workflows/pr.yml", ".github/workflows/main.yml"],
            "matchStrings": [
              "(?:^|\\n)  test-integrations:[\\s\\S]*?scalarapi/playwright-runner:(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9_.-]+)?)"
            ],
            "bumpType": "sync"
          },
          {
            "name": "Playwright test-block-snapshots runner",
            "filePatterns": [".github/workflows/pr.yml", ".github/workflows/main.yml"],
            "matchStrings": [
              "(?:^|\\n)  test-block-snapshots:[\\s\\S]*?scalarapi/playwright-runner:(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9_.-]+)?)"
            ],
            "bumpType": "sync"
          },
          {
            "name": "Playwright test-component-snapshots runner",
            "filePatterns": [".github/workflows/pr.yml", ".github/workflows/main.yml"],
            "matchStrings": [
              "(?:^|\\n)  test-component-snapshots:[\\s\\S]*?scalarapi/playwright-runner:(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9_.-]+)?)"
            ],
            "bumpType": "sync"
          },
          {
            "name": "Playwright test-e2e-api-reference runner",
            "filePatterns": [".github/workflows/pr.yml", ".github/workflows/main.yml"],
            "matchStrings": [
              "(?:^|\\n)  test-e2e-api-reference:[\\s\\S]*?scalarapi/playwright-runner:(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9_.-]+)?)"
            ],
            "bumpType": "sync"
          },
          {
            "name": "Playwright test-e2e-scalar-app runner",
            "filePatterns": [".github/workflows/pr.yml", ".github/workflows/main.yml"],
            "matchStrings": [
              "(?:^|\\n)  test-e2e-scalar-app:[\\s\\S]*?scalarapi/playwright-runner:(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9_.-]+)?)"
            ],
            "bumpType": "sync"
          }
        ]
      }
    ]
  }
}
